SRC 010: PYTHON/RDKIT: Property calculation (equivalent to cxcalc)
#-----------------------------------------------------------------------------------------

 from rdkit import Chem
 from rdkit.Chem import Descriptors, rdMolDescriptors

 mol Chem.MolFromSmiles("CC(O)Oc1ccccc1C(O)O") # aspirin

 logP    Descriptors.MolLogP(mol)      # Wildman-Crippen LogP
 mw     Descriptors.ExactMolWt(mol)     # exact molecular weight
 tpsa    rdMolDescriptors.CalcTPSA(mol)    # topological polar surface area
 hbd    rdMolDescriptors.CalcNumHBD(mol)   # H-bond donors
 hba    rdMolDescriptors.CalcNumHBA(mol)   # H-bond acceptors
 rings   rdMolDescriptors.CalcNumRings(mol)
 rot_bonds rdMolDescriptors.CalcNumRotatableBonds(mol)
 formula  rdMolDescriptors.CalcMolFormula(mol)

 print(f"Formula{formula} MW{mw:.2f}")
 print(f"LogP{logP:.2f} TPSA{tpsa:.2f}")
 print(f"HBD{hbd} HBA{hba} Rings{rings} RotBonds{rot_bonds}")

