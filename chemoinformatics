SRC 005: PYTHON/RDKIT: SMILES to 2D image and 3D conformer
#-----------------------------------------------------------------------------------------

 from rdkit import Chem
 from rdkit.Chem import Draw, AllChem

 # Parse SMILES
 mol Chem.MolFromSmiles("c1ccc(O)cc1") # phenol

 # Generate 2D coordinates and draw
 AllChem.Compute2DCoords(mol)
 img Draw.MolToImage(mol, size(300, 300))
 img.save("phenol_2d.png")

 # Generate 3D conformer (ETKDGv3 algorithm)
 mol_h Chem.AddHs(mol)
 AllChem.EmbedMolecule(mol_h, AllChem.ETKDGv3())
 AllChem.MMFFOptimizeMolecule(mol_h) # energy minimize with MMFF94

 # Save as SDF
 writer Chem.SDWriter("phenol_3d.sdf")
 writer.write(mol_h)
 writer.close()

